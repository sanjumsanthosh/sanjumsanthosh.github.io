---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Pendulum from '../components/Pendulum.astro';
import LiveSurfaces from '../components/LiveSurfaces.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = projects.filter((p) => p.data.featured);
const signature = featured.slice(0, 3);
const rest = featured.slice(3);
const live = featured.filter((p) => p.data.links?.demo).length;

const receipts = [
  { n: '5', label: 'years at Oracle' },
  { n: '6', label: 'outstanding evaluations' },
  { n: String(projects.length), label: 'case studies' },
  { n: String(live), label: 'live demos' },
  { n: '51', label: 'public repositories' },
];

const corrections = [
  {
    year: '2026',
    title: 'I published a speedup without an accuracy number',
    body: 'The INT8 benchmark showed 2× lower latency and I nearly wrote "quantization works". FP32 and INT8 disagreed on top-1 predictions, so the honest claim is narrower: this measures latency. The page says that now.',
  },
  {
    year: '2026',
    title: 'I reverted my own fail-fast guard',
    body: 'I added a startup guard that rejected a blank proxy host when the Azure proxy was enabled. It broke startup in a configuration I had not considered. Reverted it and put the direct config path back, with a test for the blank-host case this time.',
  },
  {
    year: '2025',
    title: 'I trusted a green pipeline over the artefact',
    body: 'A release build passed while the signed JAR was broken downstream. The lesson stuck: verify the thing that ships, not the job that says it shipped.',
  },
];

const capabilities = [
  {
    title: 'Retrieval & Gen AI',
    body: 'RAG pipeline design — chunking, embeddings, vector search, query routing, reranking and context assembly. Evaluation of retrieval quality, not just latency.',
  },
  {
    title: 'Agents & tooling',
    body: 'MCP servers, scoped tool access, OAuth 2.0 + PKCE, guardrails, audit transcripts and human handoff. Agents that run inside real processes.',
  },
  {
    title: 'Platform & backend',
    body: 'Java and Python services, event-driven delivery across Kafka-style topics, migration APIs, observability, security triage and release engineering.',
  },
  {
    title: 'Interactive 3D & XR',
    body: 'WebGL/Three.js scenes, WebXR controllers, C++17 physics compiled to WebAssembly, and learner-facing controls that make a model legible.',
  },
];
---

<Base>
  <section class="hero wrap">
    <div class="hero__grid">
      <div class="hero__copy">
        <div class="hero__meta meta">
          <span>Kerala, India</span>
          <span>Backend · retrieval · applied AI</span>
          <span>Open to senior roles</span>
        </div>

        <h1 class="display">
          I build the parts of AI systems that <em>have to work</em> after the demo.
        </h1>

        <p class="hero__lede">
          Five years at Oracle on backend and platform systems, and the last two on retrieval
          and agent infrastructure — scoped tools, permissions, guardrails, and the evaluation
          that tells you whether any of it is actually working.
        </p>

        <div class="hero__actions">
          <a class="link-arrow" href="/work/">See the work <span aria-hidden="true">→</span></a>
          <a class="link-arrow" href="/notes/">Field notes <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <figure class="hero__figure">
        <Pendulum />
        <figcaption class="meta">
          The physics core from <a class="link-plain" href="/work/xr-pendulum-lab/">XR Pendulum
          Lab</a>, flattened into 2D so it loads in a few hundred bytes of script.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: var(--s7)">
    <div class="receipts">
      {receipts.map((r) => (
        <div class="receipt">
          <b>{r.n}</b>
          <span>{r.label}</span>
        </div>
      ))}
    </div>
  </section>

  <LiveSurfaces />

  <section class="section rule-top">
    <div class="wrap">
      <p class="eyebrow">Signature work</p>
      <div class="card-grid" style="margin-top: var(--s6)">
        {signature.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section--tight rule-top">
    <div class="wrap">
      <p class="eyebrow">Also recent</p>
      <div class="card-grid" style="margin-top: var(--s6)">
        {rest.map((p, i) => <ProjectCard project={p} index={i + signature.length} />)}
      </div>
    </div>
  </section>

  <section class="section rule-top">
    <div class="wrap">
      <div style="max-width: 62ch">
        <p class="eyebrow">Corrections</p>
        <h2 style="margin-top: var(--s3)">Things I got wrong</h2>
        <p class="lead" style="margin-top: var(--s3)">
          Kept on purpose. A portfolio that only lists wins is a brochure, and I have been
          corrected enough times to think the corrections are the useful part.
        </p>
      </div>

      <div class="corrections" style="margin-top: var(--s6); max-width: 72ch">
        {corrections.map((c) => (
          <div class="correction">
            <span class="correction__year">{c.year}</span>
            <div>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section rule-top">
    <div class="wrap">
      <p class="eyebrow">What I work on</p>
      <div class="caps" style="margin-top: var(--s6)">
        {capabilities.map((c) => (
          <div class="cap">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section rule-top">
    <div class="wrap">
      <div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s6); align-items: end; flex-wrap: wrap;">
        <div>
          <p class="eyebrow">Get in touch</p>
          <h2 style="margin-top: var(--s3)">Building something that needs this combination?</h2>
          <p class="lead" style="margin-top: var(--s4)">
            I'm interested in applied AI, retrieval and agent platform roles — especially where
            the systems have to survive contact with real users and real permissions.
          </p>
        </div>
        <a class="link-arrow" href="mailto:sanjumsanthosh@gmail.com">sanjumsanthosh@gmail.com <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: var(--s8) var(--s7);
    align-items: start;
  }

  .hero__figure {
    margin: 0;
    padding: var(--s4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .hero__figure figcaption {
    margin-top: var(--s3);
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--muted);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }

    .hero__figure {
      max-width: 560px;
    }
  }
</style>
