---
import EvidenceStrip from './EvidenceStrip.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary: string;
      year: string;
      themes: string[];
      stack: string[];
      evidence: string[];
      links?: { repo?: string; demo?: string };
      cover?: string;
    };
  };
  index?: number;
}

const { project, index } = Astro.props;
const { title, summary, year, themes, evidence, cover } = project.data;
const demo = project.data.links?.demo;
const glyph = title.trim().charAt(0).toUpperCase();
const plate = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---

<article class="pcard work-item" data-themes={themes.join(' ')}>
  <div class="pcard__figure" aria-hidden="true">
    {cover ? (
      <img src={cover} alt="" loading="lazy" />
    ) : (
      <>
        {plate && <span class="pcard__plate">{plate}</span>}
        <span class="pcard__glyph">{glyph}</span>
        <span class="pcard__year">{year}</span>
      </>
    )}
  </div>
  <div class="pcard__body">
    <p class="meta">{year} · {themes[0]?.replace(/-/g, ' ')}</p>
    <h3 class="pcard__title"><a href={`/work/${project.id}/`}>{title}</a></h3>
    <p class="pcard__summary">{summary}</p>
    <div class="pcard__foot">
      <EvidenceStrip evidence={evidence} />
      {demo && (
        <a class="pcard__live" href={demo} target="_blank" rel="noopener">
          live <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .pcard {
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .pcard:hover,
  .pcard:focus-within {
    border-color: var(--rule-strong);
    box-shadow: 0 12px 30px -24px rgb(20 16 14 / 0.55);
  }

  .pcard:hover .pcard__glyph {
    color: var(--accent);
  }

  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    flex-wrap: wrap;
  }

  .pcard__live {
    position: relative;
    z-index: 2;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }

  .pcard__live:hover,
  .pcard__live:focus-visible {
    border-bottom-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard,
    .pcard:hover {
      transform: none;
      transition: none;
    }
  }
</style>
