---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = 'Sanjay M Santhosh — backend, retrieval and applied AI',
  description = 'Backend and platform engineer building retrieval and agent systems: RAG pipelines, MCP tooling, event-driven services and interactive 3D learning tools.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Sanjay') ? title : `${title} — Sanjay M Santhosh`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sanjay M Santhosh" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- set detox preference before first paint to avoid a flash -->
    <script is:inline>
      try {
        if (localStorage.getItem('detox') === 'on') {
          document.documentElement.dataset.detox = 'on';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const root = document.documentElement;
      const KEY = 'detox';

      const isOn = () => root.dataset.detox === 'on';

      function sync() {
        const on = isOn();
        document.querySelectorAll<HTMLButtonElement>('[data-detox-toggle]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(on));
          btn.textContent = on ? 'detox: on' : 'detox: off';
        });
      }

      function set(on: boolean) {
        root.dataset.detox = on ? 'on' : 'off';
        try {
          localStorage.setItem(KEY, on ? 'on' : 'off');
        } catch (e) {}
        sync();
      }

      function toggle() {
        set(!isOn());
      }

      sync();

      document.querySelectorAll('[data-detox-toggle]').forEach((btn) => {
        btn.addEventListener('click', toggle);
      });

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key.toLowerCase() !== 'd') return;
        const t = e.target as HTMLElement | null;
        if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
        if (t && t.isContentEditable) return;
        e.preventDefault();
        toggle();
      });
    </script>
  </body>
</html>
